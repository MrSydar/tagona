# Tagger service configuration
# Copy to .env (or export) and adjust values.

# HTTP listen address
TAGGER_HTTP_ADDR=:8081

# Base URL of the storage service
TAGGER_STORAGE_BASE_URL=http://localhost:8080

# Evaluator to use: grep | false | openai | vercel
TAGGER_EVALUATOR_IMPL=grep

# OpenAI evaluator (used when TAGGER_EVALUATOR_IMPL=openai)
TAGGER_OPENAI_API_KEY=
TAGGER_OPENAI_BASE_URL=https://api.openai.com/v1
TAGGER_OPENAI_MODEL=gpt-4o-mini
TAGGER_OPENAI_TIMEOUT=60s

# Vercel AI Gateway evaluator (used when TAGGER_EVALUATOR_IMPL=vercel)
TAGGER_VERCEL_API_KEY=
TAGGER_VERCEL_BASE_URL=https://ai-gateway.vercel.sh/v1
TAGGER_VERCEL_MODEL=typesafe-ai/jev
TAGGER_VERCEL_THRESHOLD=0.5
TAGGER_VERCEL_TIMEOUT=60s
