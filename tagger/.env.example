# Tagger service configuration
# Copy to .env (or export) and adjust values.

# HTTP listen address
TAGGER_HTTP_ADDR=:8081

# Base URL of the storage service
TAGGER_STORAGE_BASE_URL=http://localhost:8080

# Evaluator to use:
#   grep                 offline substring match (default)
#   false                every tag is false (testing)
#   completions/openai   an LLM through a chat completions API in the OpenAI dialect
#   decisions/openai     OpenAI's Decisions API: one yes/no question per tag, with probabilities
#   decisions/vercel     the Vercel AI Gateway evaluate endpoint (the same idea, another wire format)
# The part after the slash names the API dialect, not the vendor: a vendor that speaks it is used with
# its own base URL. Each LLM-backed evaluator reads the variables named after it (the prefix is
# TAGGER_<KIND>_<DIALECT>_, e.g. TAGGER_DECISIONS_OPENAI_), and all of them share the settings below.
TAGGER_EVALUATOR_IMPL=grep

# --- completions/openai (defaults shown) ---
# TAGGER_COMPLETIONS_OPENAI_API_KEY=
# TAGGER_COMPLETIONS_OPENAI_BASE_URL=https://api.openai.com/v1
# TAGGER_COMPLETIONS_OPENAI_PATH=/chat/completions
# TAGGER_COMPLETIONS_OPENAI_MODEL=gpt-4o-mini
# TAGGER_COMPLETIONS_OPENAI_TIMEOUT=60s
# TAGGER_COMPLETIONS_OPENAI_SYSTEM_PROMPT=You are a tag evaluation engine that responds only with JSON.

# --- decisions/openai (defaults shown) ---
# TAGGER_DECISIONS_OPENAI_API_KEY=
# TAGGER_DECISIONS_OPENAI_BASE_URL=https://api.openai.com/v1
# TAGGER_DECISIONS_OPENAI_PATH=/decisions
# TAGGER_DECISIONS_OPENAI_MODEL=gpt-6-luna
# TAGGER_DECISIONS_OPENAI_TIMEOUT=60s
# TAGGER_DECISIONS_OPENAI_THRESHOLD=0.5     # a tag is true when the probability is at least this
# TAGGER_DECISIONS_OPENAI_BATCH_SIZE=50     # questions per request; 0 sends all tags at once

# --- decisions/vercel (defaults shown) ---
# TAGGER_DECISIONS_VERCEL_API_KEY=
# TAGGER_DECISIONS_VERCEL_BASE_URL=https://ai-gateway.vercel.sh/v1
# TAGGER_DECISIONS_VERCEL_PATH=/evaluate
# TAGGER_DECISIONS_VERCEL_MODEL=typesafe-ai/jev
# TAGGER_DECISIONS_VERCEL_TIMEOUT=60s
# TAGGER_DECISIONS_VERCEL_THRESHOLD=0.5
# TAGGER_DECISIONS_VERCEL_BATCH_SIZE=50

# --- settings every LLM-backed evaluator also reads (P = its prefix, e.g. TAGGER_DECISIONS_OPENAI_) ---
# P AUTH_HEADER   header that carries the key (default Authorization)
# P AUTH_SCHEME   prefix of the header value (default "Bearer"); set it empty to send the bare key
# P HEADERS       extra request headers, a JSON object:   {"OpenAI-Organization":"org-1"}
# P QUERY         extra query parameters:                 api-version=2024-10-21
# P PARAMS        extra top-level body fields, a JSON object; they override the evaluator's own
#                 fields, and null removes one:           {"max_completion_tokens":50,"temperature":null}
# P INSTRUCTIONS  decisions only: the question put for each tag; must contain {tag}
#
# Example: a vendor with an OpenAI-compatible chat API under another URL that wants an "api-key" header
# TAGGER_EVALUATOR_IMPL=completions/openai
# TAGGER_COMPLETIONS_OPENAI_BASE_URL=https://llm.internal.example/openai/deployments/d1
# TAGGER_COMPLETIONS_OPENAI_MODEL=d1
# TAGGER_COMPLETIONS_OPENAI_AUTH_HEADER=api-key
# TAGGER_COMPLETIONS_OPENAI_AUTH_SCHEME=
# TAGGER_COMPLETIONS_OPENAI_QUERY=api-version=2024-10-21
