# Storage service configuration
# Copy to .env (or export) and adjust values.

# HTTP listen address
TAGONA_HTTP_ADDR=:8082

# Postgres DSN (required)
TAGONA_PG_DSN=postgres://tagona:tagona@localhost:5432/tagona?sslmode=disable

# S3-compatible object storage (required)
TAGONA_S3_ENDPOINT=http://localhost:3900
TAGONA_S3_REGION=us-east-1
TAGONA_S3_BUCKET=tagona
TAGONA_S3_ACCESS_KEY=tagonadev
TAGONA_S3_SECRET_KEY=tagona-dev-secret
TAGONA_S3_FORCE_PATH_STYLE=true

# Tagging engine (required)
TAGONA_TAG_ENGINE_URL=http://localhost:8081
TAGONA_TAG_ENGINE_TIMEOUT=30s
# Objects one query has the tagger evaluate at once, and the tagger calls in flight in the whole service
TAGONA_QUERY_CONCURRENCY=4
TAGONA_TAG_ENGINE_MAX_CONCURRENCY=16

# Query limits
TAGONA_DEFAULT_LIMIT=5
TAGONA_MAX_LIMIT=100
TAGONA_MAX_TAGS_PER_QUERY=100

# Retention
TAGONA_DEFAULT_TTL=0
TAGONA_RETENTION_SWEEP_INTERVAL=60s
TAGONA_RETENTION_BATCH_SIZE=100

# Uploads
TAGONA_MAX_OBJECT_SIZE_BYTES=10485760
