      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Tagger Errors/sec",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(tagger_errors_total[5m]))",
